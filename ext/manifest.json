{
  "manifest_version": 3,
  "name": "min",
  "version": "0.2.0",
  "description": "tell it what to do in your tabs",
  "key": "",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "min"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+M"
      }
    }
  }
}
